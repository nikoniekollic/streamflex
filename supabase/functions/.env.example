# Secrets Edge Functions : supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement par Supabase)
#
# Les clés ci-dessous peuvent AUSSI être gérées sans redéploiement dans /admin/security (Supabase Vault,
# prioritaire) ; les variables d'environnement servent de repli.

# CORS : domaine(s) du front (Vercel)
ALLOWED_ORIGIN=https://<ton-projet>.vercel.app

# Débridage (serveur uniquement — ne JAMAIS préfixer VITE_)
ALLDEBRID_API_KEY=
ALLDEBRID_AGENT=streamflex
PIXELDRAIN_API_KEY=

# Cache Redis (au choix)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Webhook d'invalidation du cache catalogue (≥ 16 caractères ; aussi à saisir dans /admin/security pour pg_net)
CATALOG_WEBHOOK_SECRET=
