# Copier en pipelines/.env — NE JAMAIS committer
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PIXELDRAIN_API_KEY=
ONEFICHIER_API_KEY=
# Dossier 1fichier cible (optionnel, id numérique)
ONEFICHIER_FOLDER_ID=
# Concurrence / limites
PIXELDRAIN_CONCURRENCY=3
ONEFICHIER_CONCURRENCY=2
PIXELDRAIN_RPS=2
ONEFICHIER_API_MIN_INTERVAL=2.5
MAX_RETRIES=6
RETRY_BASE_DELAY=2
RETRY_MAX_DELAY=120
# Priorité des sources (plus bas = préféré par resolve-stream)
PIXELDRAIN_PRIORITY=10
ONEFICHIER_PRIORITY=20
STATE_FILE=.state/uploads.json
