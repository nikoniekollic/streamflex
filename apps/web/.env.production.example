# Variables Vercel (Project → Settings → Environment Variables → Production + Preview)
# Publiques (embarquées dans le bundle) : uniquement l'URL et la clé anon/publishable.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-ou-publishable-key>
# Données de démonstration si catalogue vide (false en production)
VITE_ENABLE_MOCKS=false
